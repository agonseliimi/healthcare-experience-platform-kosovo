# ---- Node / frontend ----
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ---- Java / backend ----
backend/target/
*.class

# ---- SQLite database files (created at runtime, never commit) ----
backend/data/*.db
backend/data/*.db-journal
backend/data/*.sqlite

# ---- Uploaded verification documents (private, never commit) ----
backend/data/uploads/

# ---- Environment / secrets ----
.env
.env.local
.env.*.local
backend/.env

# ---- OS / editor ----
.DS_Store
Thumbs.db
.vscode/
.idea/

# ---- Logs ----
*.log
npm-debug.log*
